---
// Главная страница на каждом языке: /et/, /ru/, /en/.
import Base from '../../layouts/Base.astro';
import Home from '../../components/pages/Home.astro';
import { ui, langs, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang].home;
---

<Base lang={lang} page="home" title={t.title} description={t.description}>
  <Home lang={lang} />
</Base>

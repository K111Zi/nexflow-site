---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import type { Lang } from '../i18n/ui';
import { GA_MEASUREMENT_ID } from '../config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Адрес этой страницы, например "/ru/". */
  path: string;
  /** Адреса этой же страницы на всех языках — для hreflang. */
  alternates: Record<Lang, string>;
}

const { lang, title, description, path, alternates } = Astro.props;
const abs = (p: string) => new URL(p, Astro.site).href;
const ogLocale: Record<Lang, string> = { et: 'et_EE', ru: 'ru_RU', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(path)} />
    {(Object.keys(alternates) as Lang[]).map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(alternates.et)} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NexFlow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      // Включаем тему до отрисовки страницы, чтобы не было «мигания».
      (function () {
        var themes = ['light', 'dark', 'emerald', 'violet'];
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          themes.indexOf(saved) !== -1
            ? saved
            : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <slot />
    {GA_MEASUREMENT_ID && <CookieBanner lang={lang} gaId={GA_MEASUREMENT_ID} />}
  </body>
</html>

---
import PageIntro from '../PageIntro.astro';
import DemoCard from '../DemoCard.astro';
import Cta from '../Cta.astro';
import { ui, demoKeys, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].projects;
---

<PageIntro eyebrow={t.eyebrow} heading={t.heading} lead={t.lead} aside={t.aside} />

<section class="section container">
  <p class="demo-tagline">{t.tagline}</p>
  <div class="demo-large-grid">
    {demoKeys.map((k) => <DemoCard lang={lang} demo={k} />)}
  </div>
</section>

<Cta lang={lang} />

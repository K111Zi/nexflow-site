---
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { ui, languages, languageNames, langPath, themeIds, type Lang } from '../i18n/ui';
import { FORM_ENDPOINT, BOOKING_URL, WHATSAPP_URL, TELEGRAM_URL } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} path={langPath[lang]} alternates={langPath}>
  <header class="header">
    <div class="container header__inner">
      <a class="logo" href={langPath[lang]}>Nex<span>Flow</span></a>
      <nav class="nav" aria-label="Main">
        <a href="#services">{t.nav.services}</a>
        <a href="#why">{t.nav.why}</a>
        <a href="#demo">{t.nav.demo}</a>
        <a href="#call">{t.nav.call}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>
      <div class="dropdown dropdown--themes">
        <button
          type="button"
          class="dropdown__toggle"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t.themes.label}
          title={t.themes.label}
        >
          <span class="swatch swatch--current" aria-hidden="true"></span>
        </button>
        <div class="dropdown__menu" role="group" aria-label={t.themes.label}>
          {
            themeIds.map((id) => (
              <button type="button" class="dropdown__item" data-theme-set={id} aria-pressed="false">
                <span class={`swatch swatch--${id}`} aria-hidden="true" />
                {t.themes[id]}
              </button>
            ))
          }
        </div>
      </div>
      <div class="dropdown dropdown--langs">
        <button type="button" class="dropdown__toggle dropdown__toggle--text" aria-haspopup="true" aria-expanded="false">
          {languages[lang]}
          <span class="dropdown__caret" aria-hidden="true">▾</span>
        </button>
        <div class="dropdown__menu">
          {
            (Object.keys(languages) as Lang[]).map((l) => (
              <a
                href={langPath[l]}
                class:list={['dropdown__item', { active: l === lang }]}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'page' : undefined}
              >
                <span class="dropdown__code">{languages[l]}</span>
                {languageNames[l]}
              </a>
            ))
          }
        </div>
      </div>
      <a class="btn btn--small header__cta" href="#contact">{t.cta.lead}</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <h1>{t.hero.title}</h1>
        <p class="hero__subtitle">{t.hero.subtitle}</p>
        <div class="hero__actions">
          <a class="btn" href="#contact">{t.cta.lead}</a>
          <a class="btn btn--ghost" href="#call">{t.cta.call}</a>
        </div>
      </div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <h2>{t.services.title}</h2>
        <div class="grid">
          {
            t.services.items.map((item, i) => (
              <article class="card">
                <span class="card__num">0{i + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="why" class="section section--alt">
      <div class="container">
        <h2>{t.why.title}</h2>
        <div class="grid">
          {
            t.why.items.map((item) => (
              <div class="feature">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="demo" class="section">
      <div class="container">
        <h2>{t.demo.title}</h2>
        <p class="section__lead">{t.demo.note}</p>
        <div class="grid">
          {
            t.demo.items.map((item) => (
              <article class="card card--demo">
                <span class="badge">{t.demo.badge}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="call" class="section section--accent">
      <div class="container call">
        <div>
          <h2>{t.call.title}</h2>
          <p>{t.call.text}</p>
        </div>
        <a class="btn btn--light" href={BOOKING_URL} target="_blank" rel="noopener" data-track="booking">{t.call.button}</a>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="container contact">
        <div>
          <h2>{t.contact.title}</h2>
          <p class="section__lead">{t.contact.text}</p>
          <p class="contact__messengers">{t.contact.messengers}</p>
          <div class="messengers">
            <a class="btn btn--ghost btn--small" href={WHATSAPP_URL} target="_blank" rel="noopener" data-track="whatsapp">WhatsApp</a>
            <a class="btn btn--ghost btn--small" href={TELEGRAM_URL} target="_blank" rel="noopener" data-track="telegram">Telegram</a>
          </div>
        </div>
        <form
          class="form"
          id="lead-form"
          method="POST"
          action={FORM_ENDPOINT}
          data-msg-sending={t.contact.sending}
          data-msg-success={t.contact.success}
          data-msg-error={t.contact.error}
        >
          <input type="hidden" name="lang" value={lang} />
          <div class="form__trap" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label>
            {t.contact.name}
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            {t.contact.contact}
            <input type="text" name="contact" required autocomplete="email" />
          </label>
          <label>
            {t.contact.task}
            <textarea name="task" rows="4"></textarea>
          </label>
          <button class="btn" type="submit">{t.contact.submit}</button>
          <p class="form__status" role="status" aria-live="polite"></p>
          <p class="form__consent">{t.contact.consent}</p>
        </form>
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script>
    // События для Google Analytics. Если аналитика не включена или нет согласия — ничего не делают.
    const track = (name: string, params: Record<string, string> = {}) => (window as any).gtag?.('event', name, params);

    document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) =>
      el.addEventListener('click', () =>
        el.dataset.track === 'booking' ? track('book_call_click') : track('contact_click', { method: el.dataset.track! }),
      ),
    );

    const root = document.documentElement;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');

    function mark(theme: string) {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === theme)));
    }

    mark(root.dataset.theme || 'light');

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const theme = b.dataset.themeSet!;
        root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch (e) {}
        mark(theme);
        closeAll();
      }),
    );

    // Выпадающие меню: открываются наведением (CSS), а на телефоне и с клавиатуры — нажатием.
    const dropdowns = document.querySelectorAll<HTMLElement>('.dropdown');

    function closeAll(except?: HTMLElement) {
      dropdowns.forEach((d) => {
        if (d === except) return;
        d.classList.remove('open');
        d.querySelector('.dropdown__toggle')?.setAttribute('aria-expanded', 'false');
      });
    }

    dropdowns.forEach((d) => {
      const toggle = d.querySelector<HTMLButtonElement>('.dropdown__toggle')!;
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = d.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(isOpen));
        closeAll(d);
      });
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.dropdown')) closeAll();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    // Форма заявки: отправка без перезагрузки страницы.
    const form = document.querySelector<HTMLFormElement>('#lead-form');
    if (form) {
      const status = form.querySelector<HTMLElement>('.form__status')!;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

      const show = (kind: 'sending' | 'success' | 'error') => {
        status.textContent = form.dataset[`msg${kind[0].toUpperCase()}${kind.slice(1)}`] || '';
        status.className = `form__status form__status--${kind}`;
      };

      // Возврат после отправки без JavaScript: ?lead=sent или ?lead=error.
      const result = new URLSearchParams(location.search).get('lead');
      if (result === 'sent' || result === 'error') {
        show(result === 'sent' ? 'success' : 'error');
        history.replaceState(null, '', location.pathname + location.hash);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submit.disabled = true;
        show('sending');
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = await res.json().catch(() => null);
          if (!res.ok || !data?.ok) throw new Error(data?.error || `HTTP ${res.status}`);
          form.reset();
          show('success');
          track('generate_lead', { form: 'contact' });
        } catch {
          show('error');
        } finally {
          submit.disabled = false;
        }
      });
    }
  </script>
</Base>

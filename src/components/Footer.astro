---
import Lines from './Lines.astro';
import { ui, pagePath, type Lang } from '../i18n/ui';
import { CONTACT_EMAIL, COMPANY } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const links = ['home', 'solutions', 'process', 'projects', 'about', 'contact'] as const;
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <div class="eyebrow">{t.footer.eyebrow}</div>
        <h2 class="footer-title"><Lines text={t.footer.title} /></h2>
        <a href={pagePath(lang, 'contact')} class="btn">{t.footer.button} <span class="arrow">↗</span></a>
      </div>
      <nav class="footer-links" aria-label={t.ui.footerNav}>
        {links.map((p) => <a href={pagePath(lang, p)}>{t.nav[p]}</a>)}
        <a href={pagePath(lang, 'privacy')}>{t.footer.privacy}</a>
        <button type="button" data-cookie-settings hidden>{t.footer.cookies}</button>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {year} {COMPANY.name}{COMPANY.regCode && ` · ${t.footer.regCode} ${COMPANY.regCode}`}</span>
      {CONTACT_EMAIL && <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>}
      <span>{t.footer.tagline}</span>
      <span>{t.footer.motto}</span>
    </div>
  </div>
</footer>

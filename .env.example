# Образец секретов. Настоящие значения задаются в Netlify:
# Site configuration → Environment variables. Для локальной проверки
# скопируйте этот файл в .env (он не попадает в git) и заполните.

# Токен бота от @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=

# ID чата, куда бот пишет заявки (ваш личный чат с ботом или группа).
TELEGRAM_CHAT_ID=
